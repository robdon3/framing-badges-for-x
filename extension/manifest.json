{
  "manifest_version": 3,
  "name": "Framing Badges for X",
  "version": "1.4.1",
  "description": "Small framing badges on x.com and X Pro posts. It scores framing, not truth. Optional on-device tone chip. No network.",
  "key": "",
  "permissions": ["storage", "nativeMessaging"],
  "host_permissions": [
    "https://x.com/*",
    "https://www.x.com/*",
    "https://pro.x.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Framing badges — it scores framing, not truth",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://www.x.com/*",
        "https://pro.x.com/*"
      ],
      "js": ["content/content-bundle.js"],
      "css": ["content/badge.css"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'none'; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
  }
}
